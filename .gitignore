# 依赖
node_modules/

# ---------------------------------------------------------------------------
# 运行时数据 —— 这块是整个仓库最不能进版本库的东西
#
# accounts.json  你的邮箱地址、服务器、加密后的授权码
# secret.key     AES-256-GCM 的主密钥，拿到它等于拿到上面那些授权码
# token.txt      本机服务的访问令牌
# *.log          诊断日志里会带邮箱地址和请求路径
# ---------------------------------------------------------------------------
server/data/

# 环境变量（server/.env.example 是模板，要提交；真的 .env 不要）
.env
.env.local

# 本机状态与生成产物
.plugin-installed
native/com.mailhub.launcher.json

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 临时
*.log
tmp/
