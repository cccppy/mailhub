# MailHub 服务端配置示例
# 复制此文件为 .env 后按需修改（不改也能跑，全部有默认值）

# 监听端口
PORT=8787
# 监听地址。127.0.0.1 表示只允许本机访问（推荐）
HOST=127.0.0.1

# 数据目录（存放账户库、密钥、令牌）
DATA_DIR=data

# 访问令牌。留空则首次启动自动生成并写入 data/token.txt
# 浏览器插件里要填和这里完全一致的值
TOKEN=

# 允许跨域访问的来源，逗号分隔；* 表示允许全部
# 生产环境建议收紧为你的插件来源，例如 chrome-extension://abcdefg...
ALLOWED_ORIGINS=*
